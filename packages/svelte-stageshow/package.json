{
  "name": "svelte-stageshow",
  "version": "0.2.1",
  "description": "Svelte 5 port of the Stageshow kit: framed faux product UI for stills and scripted demos.",
  "keywords": [
    "svelte",
    "svelte5",
    "svelte-kit",
    "stageshow",
    "faux-ui",
    "mockup",
    "product-shot",
    "screenshot",
    "demo",
    "animation",
    "cursor",
    "landing-page",
    "design-system",
    "components"
  ],
  "license": "MIT",
  "author": "Ammar (maven-ammar)",
  "contributors": ["Benji Taylor (original Stageshow, MIT)"],
  "homepage": "https://svelte-stageshow.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maven-ammar/svelte-stageshow.git",
    "directory": "packages/svelte-stageshow"
  },
  "bugs": {
    "url": "https://github.com/maven-ammar/svelte-stageshow/issues"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/stageshow.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "svelte-package && node scripts/build-css.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "pack:tarball": "pnpm build && pnpm pack"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.4.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "svelte": "^5.39.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}

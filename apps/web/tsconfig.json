{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["svelte", "node"],
    "baseUrl": ".",
    "paths": {
      "svelte-stageshow": ["../../packages/svelte-stageshow/src/lib/index.ts"],
      "svelte-stageshow/style.css": ["../../packages/svelte-stageshow/src/lib/stageshow.css"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts", "svelte.config.js"]
}
